{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": { "obsidian": ["node_modules/obsidian"] },
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictFunctionTypes": true,
    "module": "ESNext",
    "target": "es2021",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
